DECISION_PORT=8081
DECISION_HOST=0.0.0.0
JUROS_URL=http://localhost:5000
# Se o módulo de Juros estiver na máquina, utilize o localhost.
# Caso contrário, alterne o 'localhost' para o IP da máquina que estiver com o Juros
# Necessário clonar esses dados para um arquivo .env na raiz do Decisão
# No terminal Windows (cmd) -> copy .env.example .env
#             Linux -> cp .env.example .env