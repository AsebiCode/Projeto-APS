DECISION_PORT=8081
DECISION_HOST=0.0.0.0
SCORE_URL=http://localhost:8080
JUROS_URL=http://localhost:5000
# Se o módulo de Juros e/ou Score estiver rodando na máquina, utilize o localhost.
# Caso contrário, troque o 'localhost' para o IP da máquina que estiver com o serviço respectivo

# É necessário clonar esses dados para um arquivo .env na raiz do Decisão
# No terminal Windows (cmd) -> copy .env.example .env
#             Linux -> cp .env.example .env